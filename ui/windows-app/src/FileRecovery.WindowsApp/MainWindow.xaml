<Window x:Class="FileRecovery.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="File Recovery" Height="760" Width="1180" MinHeight="620" MinWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" CornerRadius="6" Padding="12" BorderBrush="#CCD2DD">
            <DockPanel>
                <TextBlock Text="Windows File Recovery" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="EngineStatusTextBlock"
                           DockPanel.Dock="Right"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"/>
            </DockPanel>
        </Border>

        <Border x:Name="ElevationWarningBorder"
                Grid.Row="1"
                Margin="0,10,0,0"
                BorderThickness="1"
                BorderBrush="#F59E0B"
                CornerRadius="6"
                Padding="10"
                Background="#FFFBEB"
                Visibility="Collapsed">
            <DockPanel>
                <Button Content="Restart Elevated"
                        Width="130"
                        DockPanel.Dock="Right"
                        Click="RestartElevatedButton_Click"/>
                <TextBlock x:Name="ElevationWarningTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#92400E"
                           Text="Running without elevation. Raw source access may fail for some devices."/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Source Selection" Padding="8" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh Sources" Width="120" Margin="0,0,8,0" Click="RefreshSourcesButton_Click"/>
                            <Button Content="Import Image" Width="110" Margin="0,0,8,0" Click="ImportImageButton_Click"/>
                            <Button Content="Acquire Image" Width="115" Click="AcquireImageButton_Click"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   Text="Recommended workflow: acquire an image first, then scan/recover from the image."/>
                    </StackPanel>

                    <DataGrid x:Name="SourcesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Height="200"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="SourcesDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="FileSystem" Binding="{Binding FileSystem}" Width="90"/>
                            <DataGridTextColumn Header="Label" Binding="{Binding VolumeLabel}" Width="90"/>
                            <DataGridTextColumn Header="Partition" Binding="{Binding PartitionInfo}" Width="140"/>
                            <DataGridTextColumn Header="Sector" Binding="{Binding SectorSizeBytes}" Width="75"/>
                            <DataGridTextColumn Header="Mounts" Binding="{Binding MountedPaths}" Width="170"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding SourcePath}" Width="190"/>
                            <DataGridTextColumn Header="Read Only" Binding="{Binding ReadOnlyEnforced}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Destination and Scan" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Destination Folder" FontWeight="SemiBold"/>
                    <DockPanel Grid.Row="1" Margin="0,6,0,10">
                        <Button Content="Browse" Width="75" DockPanel.Dock="Right" Click="BrowseDestinationButton_Click"/>
                        <TextBox x:Name="DestinationPathTextBox" Margin="0,0,8,0" MinWidth="220"/>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Scan Mode" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ScanModeComboBox" Grid.Row="3" Margin="0,6,0,12" MinWidth="220"/>

                    <StackPanel Grid.Row="4" Margin="0,0,0,12">
                        <TextBlock Text="Carving Families (Full Scan)" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="CarveImagesCheckBox" Content="Images" Margin="0,0,12,0" IsChecked="True"/>
                            <CheckBox x:Name="CarveDocumentsCheckBox" Content="Documents" Margin="0,0,12,0" IsChecked="True"/>
                            <CheckBox x:Name="CarveArchivesCheckBox" Content="Archives" Margin="0,0,12,0" IsChecked="True"/>
                            <CheckBox x:Name="CarveOfficeCheckBox" Content="Office" Margin="0,0,12,0"/>
                            <CheckBox x:Name="CarveMediaCheckBox" Content="Media"/>
                        </WrapPanel>
                    </StackPanel>

                    <Expander Grid.Row="5" Header="Advanced Settings" IsExpanded="False" Margin="0,0,0,10">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Quick scan max records"/>
                            <TextBox x:Name="QuickScanMaxRecordsTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,6" Text="2048"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Candidate capacity"/>
                            <TextBox x:Name="CandidateCapacityTextBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,6" Text="1024"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Preview cap MiB / chunk KiB"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBox x:Name="PreviewCapMiBTextBox" Width="52" Text="8"/>
                                <TextBlock Margin="6,4,6,0" Text="/"/>
                                <TextBox x:Name="PreviewChunkKiBTextBox" Width="52" Text="1024"/>
                            </StackPanel>

                            <CheckBox x:Name="RaidManualOverrideCheckBox"
                                      Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      Margin="0,8,0,6"
                                      Content="Enable RAID manual override (expert)"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="RAID level (raid0/raid1/raid4/raid5/raid6/raid10)"/>
                            <TextBox x:Name="RaidLevelOverrideTextBox" Grid.Row="4" Grid.Column="1" Margin="8,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="RAID stripe size bytes"/>
                            <TextBox x:Name="RaidStripeSizeTextBox" Grid.Row="5" Grid.Column="1" Margin="8,0,0,6"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="RAID data offset bytes"/>
                            <TextBox x:Name="RaidDataOffsetTextBox" Grid.Row="6" Grid.Column="1" Margin="8,0,0,6"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="RAID parity rotation (left/right)"/>
                            <TextBox x:Name="RaidParityRotationTextBox" Grid.Row="7" Grid.Column="1" Margin="8,0,0,6"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="RAID disk order (comma separated)"/>
                            <TextBox x:Name="RaidDiskOrderTextBox" Grid.Row="8" Grid.Column="1" Margin="8,0,0,0"/>
                        </Grid>
                    </Expander>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Validate Safety" Width="120" Margin="0,0,8,0" Click="ValidateSafetyButton_Click"/>
                        <Button Content="Start Session" Width="110" Click="StartSessionButton_Click"/>
                        <Button Content="Cancel Operation" Width="120" Margin="8,0,0,0" Click="CancelPreviewButton_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3" Margin="0,14,0,0" Header="Validation Output" Padding="8">
            <ListBox x:Name="ValidationListBox" Height="70"/>
        </GroupBox>

        <GroupBox Grid.Row="4" Margin="0,14,0,0" Header="Session and Diagnostics" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock FontWeight="SemiBold" Text="Session Log"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy Log" Width="90" Margin="0,0,8,0" Click="CopySessionLogButton_Click"/>
                        <Button Content="Clear Log" Width="90" Click="ClearSessionLogButton_Click"/>
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="SessionOutputTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         MinHeight="110"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="SessionOutputTextBox_PreviewMouseWheel"/>

                <GridSplitter Grid.Row="2"
                              Height="6"
                              Margin="0,6,0,6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Background="#D6DBE6"/>

                <DockPanel Grid.Row="3" Margin="0,0,0,6">
                    <TextBlock FontWeight="SemiBold" Text="Quick Scan Candidates"/>
                    <TextBlock x:Name="CandidateSummaryTextBlock"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#4B5563"/>
                </DockPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Select All" Width="90" Margin="0,0,8,0" Click="SelectAllCandidatesButton_Click"/>
                    <Button Content="Select Recoverable" Width="130" Margin="0,0,8,0" Click="SelectRecoverableCandidatesButton_Click"/>
                    <Button Content="Clear Selection" Width="110" Margin="0,0,8,0" Click="ClearCandidateSelectionButton_Click"/>
                    <Button Content="Recover Selected" Width="120" Margin="0,0,8,0" Click="RecoverSelectedCandidatesButton_Click"/>
                    <Button Content="Export Selected" Width="120" Margin="0,0,8,0" Click="ExportSelectedCandidatesButton_Click"/>
                    <Button Content="Resume Latest Session" Width="150" Margin="0,0,8,0" Click="ResumeLatestSessionButton_Click"/>
                    <Button Content="Session DB Maintenance" Width="170" Click="SessionMaintenanceButton_Click"/>
                </StackPanel>

                <Border Grid.Row="5" Margin="0,0,0,6" Padding="8" BorderThickness="1" CornerRadius="4" BorderBrush="#D6DBE6" Background="#F8FAFC">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="FilterDeletedCheckBox" Content="Deleted only" Margin="0,0,12,0" Checked="CandidateFilterChanged" Unchecked="CandidateFilterChanged"/>
                                <CheckBox x:Name="FilterRecoverableCheckBox" Content="Recoverable only" Margin="0,0,12,0" Checked="CandidateFilterChanged" Unchecked="CandidateFilterChanged"/>
                                <CheckBox x:Name="FilterSelectedCheckBox" Content="Selected only" Margin="0,0,12,0" Checked="CandidateFilterChanged" Unchecked="CandidateFilterChanged"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="CandidateSearchTextBox" Width="220" Margin="0,0,8,0" TextChanged="CandidateSearchTextBox_TextChanged"/>
                                <Button Content="Reset View" Width="90" Click="ResetCandidateFiltersButton_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="File Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FilterFileTypeComboBox" Width="130" Margin="0,0,10,0" SelectionChanged="CandidateFilterChanged"/>
                            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FilterStatusComboBox" Width="140" Margin="0,0,10,0" SelectionChanged="CandidateFilterChanged"/>
                            <TextBlock Text="Evidence:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FilterEvidenceComboBox" Width="130" Margin="0,0,10,0" SelectionChanged="CandidateFilterChanged"/>
                            <TextBlock Text="Confidence:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FilterConfidenceComboBox" Width="130" Margin="0,0,10,0" SelectionChanged="CandidateFilterChanged"/>
                            <TextBlock Text="Size Min:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterMinSizeBytesTextBox" Width="90" Margin="0,0,10,0" TextChanged="CandidateFilterValueChanged"/>
                            <TextBlock Text="Size Max:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterMaxSizeBytesTextBox" Width="90" Margin="0,0,10,0" TextChanged="CandidateFilterValueChanged"/>
                            <TextBlock Text="Modified From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FilterModifiedFromDatePicker" Width="128" Margin="0,0,10,0" SelectedDateChanged="CandidateFilterValueChanged"/>
                            <TextBlock Text="Modified To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FilterModifiedToDatePicker" Width="128" Margin="0,0,10,0" SelectedDateChanged="CandidateFilterValueChanged"/>
                            <TextBlock Text="Deleted From (MFT):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FilterDeletedFromDatePicker" Width="138" Margin="0,0,10,0" SelectedDateChanged="CandidateFilterValueChanged"/>
                            <TextBlock Text="Deleted To (MFT):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FilterDeletedToDatePicker" Width="138" SelectedDateChanged="CandidateFilterValueChanged"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="QuickScanCandidatesDataGrid"
                          Grid.Row="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          MinHeight="180"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          FrozenColumnCount="2"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          CellEditEnding="QuickScanCandidatesDataGrid_CellEditEnding"
                          CurrentCellChanged="QuickScanCandidatesDataGrid_CurrentCellChanged"
                          SelectionChanged="QuickScanCandidatesDataGrid_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CandidateStatusCode}" Value="full">
                                    <Setter Property="Background" Value="#ECFDF5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CandidateStatusCode}" Value="partial">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CandidateStatusCode}" Value="overwritten-risk">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CandidateStatusCode}" Value="invalid">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="Record" Binding="{Binding RecordNumber}" Width="70" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Deleted" Binding="{Binding Deleted}" Width="70" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Ghost" Binding="{Binding IsGhostRecord}" Width="65" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Directory" Binding="{Binding Directory}" Width="80" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="NonResidentData" Binding="{Binding NonResidentData}" Width="120" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="ADS" Binding="{Binding HasNamedDataStreams}" Width="55" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Compressed" Binding="{Binding IsCompressed}" Width="88" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Sparse" Binding="{Binding IsSparse}" Width="65" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Encrypted" Binding="{Binding IsEncrypted}" Width="78" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="File Type" Binding="{Binding FileType}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Recovered Path" Binding="{Binding RecoveredPath}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Data Size" Binding="{Binding DataSizeDisplay}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Modified UTC" Binding="{Binding ModifiedUtcDisplay}" Width="165" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Attr" Binding="{Binding FileAttributesDisplay}" Width="92" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Carve Format" Binding="{Binding CarveFormat}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Carve Offset" Binding="{Binding CarveOffsetDisplay}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Parent Record" Binding="{Binding ParentRecord}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cluster" Binding="{Binding ClusterDisplay}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Deduped" Binding="{Binding DedupDisplay}" Width="72" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceSource}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceTier}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Confidence Score" Binding="{Binding ConfidenceScoreDisplay}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Confidence Reason" Binding="{Binding ConfidenceReason}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding CandidateStatusCode}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Recover Code" Binding="{Binding RecoveryStatusCodeDisplay}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Diag Flags" Binding="{Binding RecoveryDiagnosticsFlagsDisplay}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Write Diagnostics" Binding="{Binding RecoveryDiagnostics}" Width="260" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GroupBox Grid.Row="7" Header="Candidate Preview" Margin="0,8,0,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PreviewHeaderTextBlock" FontWeight="SemiBold" Text="Select a candidate to preview metadata and recovered content."/>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PreviewSummaryTextBox"
                                     Grid.Column="0"
                                     Margin="0,0,8,0"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TabControl Grid.Column="1">
                                <TabItem Header="Text Preview">
                                    <TextBox x:Name="PreviewTextTextBox"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>
                                </TabItem>
                                <TabItem Header="Image Preview">
                                    <Border Margin="6" BorderBrush="#D6DBE6" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <Image x:Name="PreviewImageControl" Stretch="Uniform"/>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Metadata">
                                    <TextBox x:Name="PreviewMetadataTextBox"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </GroupBox>

                <Expander Grid.Row="8" Margin="0,8,0,0" Header="Table Activity Log" IsExpanded="False">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Foreground="#4B5563" Text="Recent table actions"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Copy Activity" Width="95" Margin="0,0,8,0" Click="CopyCandidateActivityButton_Click"/>
                                <Button Content="Clear Activity" Width="95" Click="ClearCandidateActivityButton_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <ListBox x:Name="CandidateActivityListBox"
                                 Grid.Row="1"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                    </Grid>
                </Expander>

                <GroupBox Grid.Row="9" Header="Diagnostics Page" Margin="0,8,0,0" Padding="8">
                    <TextBox x:Name="DiagnosticsPageTextBox"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>

                <GroupBox Grid.Row="10" Header="Safety Warnings Page" Margin="0,8,0,0" Padding="8">
                    <ListBox x:Name="SafetyWarningsListBox"/>
                </GroupBox>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="5" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ThroughputStatusTextBlock" Text="Throughput: -"/>
            </StatusBarItem>
            <StatusBarItem MinWidth="180">
                <ProgressBar x:Name="OperationProgressBar" Height="14" Minimum="0" Maximum="100" Value="0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    </ScrollViewer>
</Window>
